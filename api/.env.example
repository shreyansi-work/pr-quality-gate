# Copy to .env (local) or .env.production (server). Never commit the real file.
DATABASE_URL=postgres://prgate:prgate_dev@localhost:5433/prgate
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string

REDIS_HOST=localhost
REDIS_PORT=6379

# Which AI reads the diffs: "ollama" (local, private, default) or "groq" (cloud, stronger model)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Per-call timeout in ms. A 7B model on CPU may need several minutes per file (default 180000)
# OLLAMA_TIMEOUT_MS=900000
# Only used when LLM_PROVIDER=groq. The diff is sent to Groq. Key from console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
REVIEW_VERIFY=true

# GitHub App (docs/GITHUB_APP.md)
GITHUB_APP_ID=5407149
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem

# Server only:
# API_TOKEN=a-long-random-string       # locks /api; the UI asks for it
# PUBLIC_URL=https://prgate.example.com # the "Details" link on the GitHub status
# POSTGRES_PASSWORD=...                 # used by docker-compose.prod.yml

# Local development only: turns on /dev/* test routes (fake PRs, refingerprint).
# Off by default. Never enable on a server.
# ENABLE_DEV_ROUTES=true
